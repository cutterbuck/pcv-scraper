# Copy to .env for local runs. .env is gitignored.

# Required. Apartment alerts. Point at the shared channel everyone should see.
# Slack Incoming Webhook: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/xxxx

# Optional. Heartbeat, failure and recovery notices. Point at a PRIVATE channel that
# only you are in, so the others are not bothered by scraper plumbing.
# Defaults to SLACK_WEBHOOK_URL when unset, putting everything in one channel.
SLACK_OPS_WEBHOOK_URL=https://hooks.slack.com/services/T000/B111/yyyy

# Alert when a unit's monthly rent is strictly below this.
# Raise temporarily if you need an alert to fire on demand for testing.
RENT_THRESHOLD=7000

# Search criteria.
BEDROOMS=2
BATHROOMS=2
PROPERTY_NAME=Peter Cooper Village

# Schedule. StuyTown posts new availability between roughly 4 and 6AM ET.
TIMEZONE=America/New_York
SCRAPE_HOURS=3-7
SCRAPE_MINUTES=0,15,30,45

# Weekly proof-of-life message, so a broken scraper is distinguishable from a quiet market.
HEARTBEAT_DAY=mon
HEARTBEAT_HOUR=9

# Where the already-alerted unit list is cached between runs.
STATE_PATH=/tmp/pcv-state.json

# Consecutive failures before Slack is told the scraper is broken.
FAILURE_ALERT_AFTER=3
